        ],
        "summary": "Token",
        "operationId": "get_jwt",
        "responses": {
          "200": {
            "$ref": "#/components/responses/authentication"
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/ptp/{market}": {
      "summary": "market",
      "description": "Returns details about selected market.",
      "get": {
        "tags": [
          "Resource"
        ],
        "summary": "Market",
        "operationId": "get_market",
        "parameters": [
          {
            "name": "market",
