{
  "openapi": "3.0.4",
  "info": {
    "title": "PowerTools Platform API",
    "description": "Welcome to the PowerTools Platform API. This page describes all endpoints and expected parameters that are available.\r\n\r\n- All date times are ISO 8601 and UTC unless otherwise noted.\r\n- Rate limiting is implemented with a sliding window per user.\r\n- Averaging more than 1 call per second over a small time period will result in 429 Too Many Requests responses.\r\n\r\n[Static API Guide documentation](https://portal.ptp.energy/api-guide)",
    "contact": {
      "name": "Customer Support",
      "email": "customersupport@tnsk.com"
    },
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://api.ptp.energy"
    }
  ],
