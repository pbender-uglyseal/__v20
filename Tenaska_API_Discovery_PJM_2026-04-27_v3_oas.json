            "required": true,
            "schema": {
              "enum": [
                "Operations",
                "PJM"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/market"
          }
        },
        "security": [
          {
            "basic": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
